# Copie este arquivo para ".env" e troque os valores. O .env não vai para o Git.

# Senha do usuário "sa" do SQL Server (mínimo 8 caracteres, com maiúscula, minúscula, número e símbolo).
SA_PASSWORD=TroqueEstaSenha@2026

# Chave usada para assinar os tokens JWT (pelo menos 32 caracteres aleatórios).
JWT_KEY=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# Chave da API do Gemini (https://aistudio.google.com/apikey). Opcional: sem ela o chat
# continua abrindo chamados, mas não responde perguntas com IA.
GEMINI_API_KEY=
